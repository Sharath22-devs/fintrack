{
  "name": "fintrack-netlify",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env scripts/dev-server.mjs",
    "dev": "npm run build && npm start",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test": "node --test tests/*.test.mjs",
    "functions:check": "node scripts/check-functions.mjs",
    "test:browser": "node tests/browser.mjs",
    "preview:test": "node tests/preview-server.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@netlify/zip-it-and-ship-it": "^16.3.0",
    "esbuild": "^0.25.10",
    "playwright": "^1.55.0"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
