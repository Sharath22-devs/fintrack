# Required: a managed PostgreSQL URL, preferably pooled, with TLS enabled.
# Use your provider's supplied connection string. Never put this in src/ or public/.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional locally. Set the canonical HTTPS URL in production after first deploy.
# APP_ORIGIN=https://your-fintrack-site.netlify.app

# Production demos are disabled by default. Use only for a controlled demo site.
ENABLE_DEMO=false

# Optional generative AI; without it the assistant uses transparent local queries.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional password-reset email service: HTTPS webhook that sends reset_url.
# RESET_DELIVERY_URL=https://your-email-service.example/reset
# RESET_DELIVERY_SECRET=

# Local development only. Never enable this in production.
# DEV_SHOW_RESET=true
